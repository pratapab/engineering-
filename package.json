{
  "name": "salesforce-automation-selenium",
  "version": "1.0.0",
  "description": "Salesforce Automation Testing with Selenium WebDriver",
  "main": "index.js",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:smoke": "wdio run wdio.conf.js --cucumberOpts.tagExpression=@smoke",
    "test:regression": "wdio run wdio.conf.js --cucumberOpts.tagExpression=@regression",
    "test:sanity": "wdio run wdio.conf.js --cucumberOpts.tagExpression=@sanity",
    "test:critical": "wdio run wdio.conf.js --cucumberOpts.tagExpression=@critical",
    "test:parallel": "wdio run wdio.conf.js --maxInstances=4",
    "test:ci": "wdio run wdio.ci.conf.js",
    "test:debug": "wdio run wdio.conf.js --spec=./tests/specs/login.feature",
    "test:chrome": "wdio run wdio.conf.js --spec=./tests/specs/login.feature --capabilities.chrome",
    "test:firefox": "wdio run wdio.conf.js --spec=./tests/specs/login.feature --capabilities.firefox",
    "test:safari": "wdio run wdio.conf.js --spec=./tests/specs/login.feature --capabilities.safari",
    "report": "allure generate allure-results --clean && allure open",
    "install:drivers": "selenium-standalone install",
    "start:selenium": "selenium-standalone start"
  },
  "dependencies": {
    "@wdio/selenium-standalone-service": "^8.15.0",
    "chai": "^4.3.10",
    "selenium-standalone": "^9.3.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@wdio/allure-reporter": "^8.21.0",
    "@wdio/cli": "^8.21.0",
    "@wdio/cucumber-framework": "^8.21.0",
    "@wdio/local-runner": "^8.46.0",
    "@wdio/mocha-framework": "^8.21.0",
    "@wdio/spec-reporter": "^8.21.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
